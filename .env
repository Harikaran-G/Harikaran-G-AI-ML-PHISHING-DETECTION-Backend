# CyberShield Backend Environment Configuration

# Service Port and Host
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Maximum static analysis file limit (in bytes, default: 50MB)
MAX_FILE_SIZE_BYTES=52428800

# Maximum APK package size limit (in bytes, default: 100MB)
MAX_APK_SIZE_BYTES=104857600
