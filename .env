# ==============================================================================
# CyberShield Backend Environment Configuration (Production)
# ==============================================================================

# Server Network & Runtime Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# CORS Allowed Origins
# Add your production frontend domain (e.g. Vercel, Render, custom domain) alongside local development
CORS_ORIGINS='["https://harikaran-g-ai-ml-phishing-detection.onrender.com", "http://localhost:3000", "http://127.0.0.1:3000"]'

# Static Analysis Upload Limits
# Maximum file upload limit for binary/document static inspection (50 MB)
MAX_FILE_SIZE_BYTES=52428800

# Maximum APK package upload limit for Android manifest & dex analysis (100 MB)
MAX_APK_SIZE_BYTES=104857600
